{
  "name": "destina",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src server shared scripts tests vite.config.ts",
    "room": "tsx scripts/room.ts",
    "tunnel": "tsx scripts/tunnel.ts",
    "questions": "tsx scripts/questions.ts",
    "chain:build": "cd solana && anchor build && npm run -w @centerpiece/chain sync-idl",
    "chain:test": "solana/scripts/test-local.sh",
    "chain:init": "npm run -w @centerpiece/chain init",
    "chain:smoke": "npm run -w @centerpiece/chain smoke",
    "chain:serve": "npm run -w @centerpiece/chain serve",
    "chain:seed-shop": "npm run -w @centerpiece/chain seed-shop",
    "questions:link": "tsx scripts/questions-link.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.1.0"
  },
  "workspaces": [
    "solana/client"
  ]
}
