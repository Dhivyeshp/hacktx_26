PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=data/centerpiece.db
MODEL_API_KEY=
MODEL_API_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.1
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
INSTAGRAM_GRAPH_VERSION=v25.0
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Shared server-side control credential for the future Vision Pro/bot adapter.
# Generate with: openssl rand -hex 32
GM_API_KEY=

# Optional HTTPS tunnel; use the agent authtoken from the ngrok dashboard.
# Reserve this domain in ngrok first; omit to use the assigned dev domain.
NGROK_URL=
NGROK_AUTHTOKEN=

# Persistent local safety cap across all Muse calls, including repair attempts.
# This is NOT a dollar limit. Check actual spending in your Meta billing dashboard.
MODEL_MAX_REQUESTS=100
MODEL_USAGE_PATH=data/model-usage.db

# --- relay ---
RELAY_TOKEN=change-me
# Clients: wss://centerpiece-relay.onrender.com/ws  (or ws://<laptop-ip>:8080/ws on venue Wi-Fi)

# --- solana ---
SOLANA_CLUSTER=devnet
# SOLANA_RPC=https://devnet.helius-rpc.com/?api-key=...   # optional; public devnet RPC is rate limited
AUTHORITY_KEYPAIR=~/.config/solana/id.json                # program admin; or set AUTHORITY_SECRET='[1,2,...]'
CHAIN_PUBLIC_URL=http://localhost:8787                    # base URL baked into on-chain metadata URIs
CHAIN_API_TOKEN=

# Hosted room transcription. Never send this key to the browser or Tina.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Conservative started-minute allowance per room, persisted across restarts.
DEEPGRAM_MAX_MINUTES=30
# Question-generation attempts per room, including repairs (not intro extraction).
GAME_MODEL_MAX_REQUESTS=12
# Optional one-use, 60-second audio ticket for the Tina PCM sender.
TINA_AUDIO_TICKET=

# Optional TigerDB (TimescaleDB) transcript store. SQLite stays the source of
# truth; this is a parallel time-series copy the Vision Pro reads by time.
# Leave blank to run without it. Run: npm run tigerdb:migrate
TIGER_DATABASE_URL=
# Set to disable only for a local Postgres without TLS.
TIGER_SSL_MODE=require

# One shared public demo. Anyone with /gm can control it and read transcripts.
# Keep false for private room-based use. Select an existing room internally.
DEMO_MODE=false
DEMO_ROOM_CODE=

# Game server's trusted Token-2022 devnet service. Uses CHAIN_API_TOKEN above.
# Mainnet services are rejected before wallets or awards are written.
CHAIN_SERVICE_URL=https://centerpiece-chain.onrender.com
