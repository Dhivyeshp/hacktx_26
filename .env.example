PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=data/centerpiece.db
MODEL_API_KEY=
MODEL_API_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.1
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
INSTAGRAM_GRAPH_VERSION=v25.0
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Shared server-side control credential for the future Vision Pro/bot adapter.
# Generate with: openssl rand -hex 32
GM_API_KEY=

# Optional HTTPS tunnel; use the agent authtoken from the ngrok dashboard.
NGROK_AUTHTOKEN=

# Persistent local safety cap across all Muse calls, including repair attempts.
# This is NOT a dollar limit. Check actual spending in your Meta billing dashboard.
MODEL_MAX_REQUESTS=100
MODEL_USAGE_PATH=data/model-usage.db

# --- relay ---
RELAY_TOKEN=change-me
# Clients: wss://centerpiece-relay.onrender.com/ws  (or ws://<laptop-ip>:8080/ws on venue Wi-Fi)

# --- solana ---
SOLANA_CLUSTER=devnet
# SOLANA_RPC=https://devnet.helius-rpc.com/?api-key=...   # optional; public devnet RPC is rate limited
AUTHORITY_KEYPAIR=~/.config/solana/id.json                # program admin; or set AUTHORITY_SECRET='[1,2,...]'
CHAIN_PUBLIC_URL=http://localhost:8787                    # base URL baked into on-chain metadata URIs
CHAIN_API_TOKEN=change-me
