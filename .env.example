# Copy to .env (gitignored). Only what the relay and Solana code read.

# --- relay ---
RELAY_TOKEN=change-me
# Clients: wss://centerpiece-relay.onrender.com/ws  (or ws://<laptop-ip>:8080/ws on venue Wi-Fi)

# --- solana ---
SOLANA_CLUSTER=devnet
# SOLANA_RPC=https://devnet.helius-rpc.com/?api-key=...   # optional; public devnet RPC is rate limited
AUTHORITY_KEYPAIR=~/.config/solana/id.json                # program admin; or set AUTHORITY_SECRET='[1,2,...]'
CHAIN_PUBLIC_URL=http://localhost:8787                    # base URL baked into on-chain metadata URIs
CHAIN_API_TOKEN=change-me
